{
  "name": "freelancing-toolkit",
  "private": true,
  "version": "1.2.0",
  "description": "Rate converter and Romanian 2026 tax calculator for freelancers (PWA).",
  "license": "MIT",
  "homepage": "https://romulusmirauta.github.io/FreelancingToolkit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RomulusMirauta/FreelancingToolkit.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "rates": "node scripts/fetch-bnr-rates.mjs && node scripts/fetch-market-rates.mjs",
    "symbols": "node scripts/gen-currency-symbols.mjs",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:browsers": "playwright test --config playwright.browsers.config.ts",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "release:check": "npm run lint && npm test && npm run build && npm run test:visual"
  },
  "dependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "oxlint": "^1.92.0",
    "stylelint": "^18.0.0",
    "stylelint-config-recommended": "^19.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.3"
    },
    "glob": {
      "minimatch": "^11.0.4"
    }
  }
}
